<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container my-5">
    <div class="row g-5">
        <div class="col-md-5">
            <h3 class="section-accent-title mb-4">Contact Information</h3>
            <p class="text-muted">Get in touch directly with our administrative office desks for structural questions or campus physical visits.</p>
            <div class="mt-4">
                <p class="mb-2"><strong>Address:</strong><br><span class="text-muted"><%= settings.contact_address %></span></p>
                <p class="mb-2"><strong>Phone Number:</strong><br><span class="text-muted"><%= settings.contact_phone %></span></p>
                <p class="mb-2"><strong>Email Address:</strong><br><span class="text-muted"><%= settings.contact_email %></span></p>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card p-4 border-0 shadow-sm bg-light">
                <h4 class="text-success fw-bold mb-3">Send a Direct Message</h4>
                <% if (successMessage) { %>
                    <div class="alert alert-success border-0 shadow-sm"><%= successMessage %></div>
                <% } %>
                <form action="/contact" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Name</label>
                        <input type="text" name="name" class="form-control" required placeholder="Full Name">
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="tel" name="phone" class="form-control" required placeholder="Phone Contact">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="email" class="form-control" required placeholder="Email Connection">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message Content</label>
                        <textarea name="message" class="form-control" rows="4" required placeholder="Write your text questions here..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-gold w-100">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
